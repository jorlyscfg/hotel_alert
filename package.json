{
  "name": "hotel-local-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.18.0 <26"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @hotel/shared build && corepack pnpm --parallel --filter @hotel/web --filter @hotel/server dev",
    "build": "corepack pnpm -r build",
    "start": "corepack pnpm --filter @hotel/server start",
    "db:migrate": "corepack pnpm --filter @hotel/shared build && tsx scripts/migrate.ts",
    "db:seed": "corepack pnpm --filter @hotel/shared build && tsx scripts/seed-demo.ts",
    "admin:create": "corepack pnpm --filter @hotel/shared build && tsx scripts/create-admin.ts",
    "backup": "corepack pnpm --filter @hotel/shared build && tsx scripts/backup.ts",
    "restore:check": "corepack pnpm --filter @hotel/shared build && tsx scripts/restore-check.ts",
    "purge:retention": "corepack pnpm --filter @hotel/shared build && tsx scripts/purge-retention.ts",
    "test": "corepack pnpm test:unit && corepack pnpm test:integration",
    "test:unit": "corepack pnpm --filter @hotel/shared build && vitest run tests/unit",
    "test:integration": "corepack pnpm --filter @hotel/shared build && vitest run tests/integration",
    "test:e2e": "corepack pnpm --filter @hotel/shared build && playwright test",
    "test:faults": "corepack pnpm --filter @hotel/shared build && vitest run tests/fault-injection",
    "lint": "eslint .",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.8",
    "@types/supertest": "6.0.2"
  }
}
