{
  "name": "@hotel/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "corepack pnpm --filter @hotel/shared build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "corepack pnpm --filter @hotel/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "predev": "corepack pnpm --filter @hotel/shared build",
    "dev": "tsx watch src/main.ts",
    "prestart": "corepack pnpm build",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hotel/shared": "workspace:*",
    "better-sqlite3": "11.7.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "supertest": "7.0.0",
    "typescript": "5.7.2"
  }
}
